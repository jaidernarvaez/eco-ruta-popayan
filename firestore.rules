rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  EcoRuta Colombia · Reglas de seguridad de Cloud Firestore
//  Colecciones: users, trucks, neighborhoods, schedules, reports
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones auxiliares ────────────────────────────────
    // Cualquier usuario autenticado: ciudadano anónimo (acceso rápido),
    // Google o correo/contraseña.
    function signedIn() {
      return request.auth != null;
    }
    // Ciudadano con acceso rápido (signInAnonymously)
    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin()  { return hasProfile() && role() == 'admin'; }
    function isDriver() { return hasProfile() && role() in ['conductor', 'admin']; }

    function validWasteType(t) { return t in ['ordinario', 'reciclable']; }

    // Coordenadas dentro del territorio colombiano (continental + San Andrés)
    function inColombia(p) {
      return p is latlng
        && p.latitude()  >= -4.3 && p.latitude()  <= 13.6
        && p.longitude() >= -82.0 && p.longitude() <= -66.8;
    }

    // Ciudades del catálogo nacional (src/data/cities.ts)
    function validCity(c) {
      return c in ['popayan', 'cali', 'bogota', 'medellin', 'barranquilla',
                   'cartagena', 'bucaramanga', 'pasto'];
    }
    // `city` es opcional en documentos antiguos (= Popayán), pero si viene debe ser válida
    function optionalCity(d) {
      return !('city' in d) || validCity(d.city);
    }

    // ── users/{uid}: perfil y rol ───────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Cada usuario crea su propio perfil; 'admin' solo se asigna desde la consola.
      // Los ciudadanos anónimos no tienen perfil (y por tanto nunca son conductores).
      allow create: if signedIn() && !isAnonymous() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['ciudadano', 'conductor']
        && request.resource.data.createdAt == request.time;

      // Solo puede cambiar su rol entre ciudadano y conductor (modo prueba).
      allow update: if signedIn() && !isAnonymous() && request.auth.uid == uid
        && resource.data.role != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['ciudadano', 'conductor'];

      allow delete: if isAdmin();
    }

    // ── trucks/{truckId}: camiones y su posición GPS ────────
    function validTruck(d) {
      return d.keys().hasOnly(['plate', 'wasteType', 'status', 'location', 'driverId',
                               'driverEmail', 'neighborhoodId', 'updatedAt', 'city'])
        && d.keys().hasAll(['plate', 'wasteType', 'status', 'location', 'driverId', 'updatedAt'])
        && d.plate is string && d.plate.matches('^[A-Z]{3}[0-9]{3}$')
        && validWasteType(d.wasteType)
        && d.status in ['en_ruta', 'detenido', 'fuera_de_servicio']
        && inColombia(d.location)
        && (!('neighborhoodId' in d) || d.neighborhoodId == null || d.neighborhoodId is string)
        && optionalCity(d)
        && d.updatedAt == request.time;
    }

    match /trucks/{truckId} {
      allow read: if signedIn();

      allow create: if isDriver()
        && validTruck(request.resource.data)
        && 'city' in request.resource.data
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.driverEmail == request.auth.token.email;

      // Un conductor solo mueve SU camión (puede cambiarlo de ciudad);
      // no puede cambiar placa, tipo ni dueño.
      allow update: if isDriver()
        && (resource.data.driverId == request.auth.uid || isAdmin())
        && validTruck(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['location', 'status', 'neighborhoodId', 'updatedAt', 'city']);

      allow delete: if isAdmin() || (isDriver() && resource.data.driverId == request.auth.uid);
    }

    // ── neighborhoods/{id}: barrios (información pública) ───
    match /neighborhoods/{id} {
      allow read: if true;
      // Conductores pueden CREAR los datos de ejemplo; solo admin modifica o borra.
      allow create: if isDriver()
        && request.resource.data.keys().hasOnly(['name', 'commune', 'center', 'city'])
        && optionalCity(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.commune is int
        && inColombia(request.resource.data.center);
      allow update, delete: if isAdmin();
    }

    // ── schedules/{id}: horarios de recolección (públicos) ──
    match /schedules/{id} {
      allow read: if true;
      allow create: if isDriver()
        && request.resource.data.keys().hasOnly(['neighborhoodId', 'wasteType', 'days', 'startTime', 'endTime', 'city'])
        && optionalCity(request.resource.data)
        && exists(/databases/$(database)/documents/neighborhoods/$(request.resource.data.neighborhoodId))
        && validWasteType(request.resource.data.wasteType)
        && request.resource.data.days is list && request.resource.data.days.size() <= 7
        && request.resource.data.startTime.matches('^[0-2][0-9]:[0-5][0-9]$')
        && request.resource.data.endTime.matches('^[0-2][0-9]:[0-5][0-9]$');
      allow update, delete: if isAdmin();
    }

    // ── reports/{id}: reportes ciudadanos / alertas ambientales ──
    match /reports/{reportId} {
      // Cualquier usuario autenticado (ciudadano o conductor) puede verlos.
      allow read: if signedIn();

      // Cualquier usuario autenticado (incluidos los ciudadanos anónimos)
      // puede crear un reporte a su nombre.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'description', 'location', 'city', 'neighborhoodId',
                                                 'status', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['type', 'description', 'location', 'city', 'status',
                                                'createdBy', 'createdAt'])
        && validCity(request.resource.data.city)
        && request.resource.data.type in ['acumulacion', 'recoleccion_prioritaria']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 280
        && inColombia(request.resource.data.location)
        && (!('neighborhoodId' in request.resource.data)
            || request.resource.data.neighborhoodId == null
            || request.resource.data.neighborhoodId is string)
        && request.resource.data.status == 'abierto'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Solo un conductor puede marcarlo como atendido (y nada más).
      allow update: if isDriver()
        && resource.data.status == 'abierto'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'attendedBy', 'attendedAt'])
        && request.resource.data.status == 'atendido'
        && request.resource.data.attendedBy == request.auth.uid
        && request.resource.data.attendedAt == request.time;

      // El autor puede retirar su reporte; el admin puede borrar cualquiera.
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Todo lo demás queda bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
